<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootToneMenu"
    android:layout_width="136dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_tone_menu"
    android:padding="6dp"
    android:elevation="14dp"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- Simple Mode -->
    <TextView
        android:id="@+id/chipToneSimple"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical|start"
        android:text="Simple"
        android:textSize="13sp"
        android:textColor="#F8FAFC"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/bg_tone_chip_active"
        android:clickable="true"
        android:focusable="true" />

    <!-- Hairline Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="6dp"
        android:layout_marginVertical="2dp"
        android:background="#15FFFFFF" />

    <!-- Formal Mode -->
    <TextView
        android:id="@+id/chipToneFormal"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical|start"
        android:text="Formal"
        android:textSize="13sp"
        android:textColor="#94A3B8"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/bg_tone_chip_inactive"
        android:clickable="true"
        android:focusable="true" />

    <!-- Hairline Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="6dp"
        android:layout_marginVertical="2dp"
        android:background="#15FFFFFF" />

    <!-- Professional Mode -->
    <TextView
        android:id="@+id/chipToneProfessional"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical|start"
        android:text="Professional"
        android:textSize="13sp"
        android:textColor="#94A3B8"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/bg_tone_chip_inactive"
        android:clickable="true"
        android:focusable="true" />

    <!-- Hairline Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="6dp"
        android:layout_marginVertical="2dp"
        android:background="#15FFFFFF" />

    <!-- Email Mode -->
    <TextView
        android:id="@+id/chipToneEmail"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical|start"
        android:text="Email"
        android:textSize="13sp"
        android:textColor="#94A3B8"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/bg_tone_chip_inactive"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
