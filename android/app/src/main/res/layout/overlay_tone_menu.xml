<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootToneMenu"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_tone_menu"
    android:padding="6dp"
    android:elevation="14dp"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- Raw Mode (Minimal Edit / Preserve Hinglish) -->
    <TextView
        android:id="@+id/chipToneRaw"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical|start"
        android:text="Raw"
        android:textSize="13sp"
        android:textColor="#94A3B8"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/bg_tone_chip_inactive"
        android:clickable="true"
        android:focusable="true" />

    <!-- Hairline Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="6dp"
        android:layout_marginVertical="2dp"
        android:background="#15FFFFFF" />

    <!-- Normal Mode (Natural Everyday English - Default) -->
    <TextView
        android:id="@+id/chipToneNormal"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical|start"
        android:text="Normal"
        android:textSize="13sp"
        android:textColor="#F8FAFC"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/bg_tone_chip_active"
        android:clickable="true"
        android:focusable="true" />

    <!-- Hairline Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="6dp"
        android:layout_marginVertical="2dp"
        android:background="#15FFFFFF" />

    <!-- Professional Mode (Workplace English) -->
    <TextView
        android:id="@+id/chipToneProfessional"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical|start"
        android:text="Professional"
        android:textSize="13sp"
        android:textColor="#94A3B8"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/bg_tone_chip_inactive"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
