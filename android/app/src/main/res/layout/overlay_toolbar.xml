<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootToolbar"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:clickable="true"
    android:focusable="false">

    <!-- Morphing AI Pill (44dp circular in normal state, expands to 156dp recording capsule) -->
    <FrameLayout
        android:id="@+id/btnRewrite"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_floating_ai_pill"
        android:elevation="8dp">

        <!-- Progress Spinner (Shown during API call) -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="#38BDF8"
            android:visibility="gone" />

        <!-- Keyflow Mode Icon (Scaled up to 30dp for crisp, prominent visibility) -->
        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_keyflow_emblem"
            android:contentDescription="@string/app_name"
            android:visibility="visible" />

        <!-- Whisper Flow Style Live Wave Recording Capsule Container -->
        <LinearLayout
            android:id="@+id/layoutVoiceVisualizer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:visibility="gone">

            <!-- Cancel Button (X) -->
            <FrameLayout
                android:id="@+id/btnCancelVoice"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_voice_cancel_btn"
                android:clickable="true"
                android:focusable="false">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_voice_cancel"
                    android:contentDescription="Cancel Recording" />
            </FrameLayout>

            <!-- Live Organic Soundwave Bars (11 Luminous Vertical Bars) -->
            <LinearLayout
                android:id="@+id/layoutWaveBars"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="4dp">

                <View
                    android:id="@+id/waveBar1"
                    android:layout_width="2.5dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="1.2dp"
                    android:background="@drawable/bg_wave_bar" />

                <View
                    android:id="@+id/waveBar2"
                    android:layout_width="2.5dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="1.2dp"
                    android:background="@drawable/bg_wave_bar" />

                <View
                    android:id="@+id/waveBar3"
                    android:layout_width="2.5dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="1.2dp"
                    android:background="@drawable/bg_wave_bar" />

                <View
                    android:id="@+id/waveBar4"
                    android:layout_width="2.5dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="1.2dp"
                    android:background="@drawable/bg_wave_bar" />

                <View
                    android:id="@+id/waveBar5"
                    android:layout_width="2.5dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="1.2dp"
                    android:background="@drawable/bg_wave_bar" />

                <View
                    android:id="@+id/waveBar6"
                    android:layout_width="2.5dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="1.2dp"
                    android:background="@drawable/bg_wave_bar" />

                <View
                    android:id="@+id/waveBar7"
                    android:layout_width="2.5dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="1.2dp"
                    android:background="@drawable/bg_wave_bar" />

                <View
                    android:id="@+id/waveBar8"
                    android:layout_width="2.5dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="1.2dp"
                    android:background="@drawable/bg_wave_bar" />

                <View
                    android:id="@+id/waveBar9"
                    android:layout_width="2.5dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="1.2dp"
                    android:background="@drawable/bg_wave_bar" />

                <View
                    android:id="@+id/waveBar10"
                    android:layout_width="2.5dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="1.2dp"
                    android:background="@drawable/bg_wave_bar" />

                <View
                    android:id="@+id/waveBar11"
                    android:layout_width="2.5dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="1.2dp"
                    android:background="@drawable/bg_wave_bar" />

            </LinearLayout>

            <!-- Done / Confirm Button (✓) -->
            <FrameLayout
                android:id="@+id/btnDoneVoice"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_voice_done_btn"
                android:clickable="true"
                android:focusable="false">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_voice_done"
                    android:contentDescription="Finish Recording" />
            </FrameLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
