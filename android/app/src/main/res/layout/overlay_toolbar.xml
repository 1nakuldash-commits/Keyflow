<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootToolbar"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="false">

    <!-- Compact Floating AI Pill (36dp height, does not block typing area) -->
    <LinearLayout
        android:id="@+id/btnRewrite"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_floating_ai_pill"
        android:elevation="10dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <!-- Progress Spinner (Shown during API call) -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent_primary"
            android:visibility="gone" />

        <!-- AI Sparkle Icon / Badge -->
        <TextView
            android:id="@+id/tvIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center" />

    </LinearLayout>

</FrameLayout>
