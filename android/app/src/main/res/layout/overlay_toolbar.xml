<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootToolbar"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:clickable="true"
    android:focusable="false">

    <!-- 1:1 Circular Floating AI Pill (44dp x 44dp) -->
    <FrameLayout
        android:id="@+id/btnRewrite"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_floating_ai_pill"
        android:elevation="8dp">

        <!-- Progress Spinner (Shown during API call) -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="#38BDF8"
            android:visibility="gone" />

        <!-- Keyflow Emblem Logo -->
        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_keyflow_emblem"
            android:contentDescription="@string/app_name"
            android:visibility="visible" />

        <!-- Voice Recording Visualizer Container -->
        <FrameLayout
            android:id="@+id/layoutVoiceVisualizer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone">

            <!-- Red Silence Indicator Dot (breathing live icon when silent) -->
            <View
                android:id="@+id/viewRedSilenceIndicator"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_silence_red_dot"
                android:visibility="visible" />

            <!-- Frequency / Amplitude Waveform Bars (shown when voice detected) -->
            <LinearLayout
                android:id="@+id/layoutWaveBars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="gone">

                <!-- Bar 1 -->
                <View
                    android:id="@+id/waveBar1"
                    android:layout_width="3dp"
                    android:layout_height="7dp"
                    android:layout_marginHorizontal="1.5dp"
                    android:background="@drawable/bg_wave_bar" />

                <!-- Bar 2 (Core left peak) -->
                <View
                    android:id="@+id/waveBar2"
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="1.5dp"
                    android:background="@drawable/bg_wave_bar" />

                <!-- Bar 3 (Core right peak) -->
                <View
                    android:id="@+id/waveBar3"
                    android:layout_width="3dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="1.5dp"
                    android:background="@drawable/bg_wave_bar" />

                <!-- Bar 4 -->
                <View
                    android:id="@+id/waveBar4"
                    android:layout_width="3dp"
                    android:layout_height="6dp"
                    android:layout_marginHorizontal="1.5dp"
                    android:background="@drawable/bg_wave_bar" />
            </LinearLayout>

        </FrameLayout>

    </FrameLayout>

</FrameLayout>
