<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootToolbar"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="false">

    <!-- Floating AI Pill (46dp height, sleek glassmorphic capsule) -->
    <LinearLayout
        android:id="@+id/btnRewrite"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:minWidth="46dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_floating_ai_pill"
        android:elevation="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- Progress Spinner (Shown during API call) -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:indeterminate="true"
            android:indeterminateTint="#38BDF8"
            android:visibility="gone" />

        <!-- Keyflow Emblem Logo -->
        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_keyflow_emblem"
            android:contentDescription="@string/app_name"
            android:visibility="visible" />

    </LinearLayout>

</FrameLayout>
