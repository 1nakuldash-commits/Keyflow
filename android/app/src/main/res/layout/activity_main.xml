<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0D13"
    android:padding="24dp">

    <!-- Header / Brand -->
    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/ic_keyflow_logo"
        android:contentDescription="@string/app_name" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KEYFLOW"
        android:textSize="12sp"
        android:letterSpacing="0.15"
        android:textAllCaps="true"
        android:textColor="@color/accent_primary"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Text Rewriter"
        android:textSize="26sp"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Turn rough English and Hinglish into clean, natural English right from your keyboard."
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="3dp" />

    <!-- Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@drawable/bg_toolbar_glass">

        <View
            android:id="@+id/viewStatusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_pill_brand"
            android:backgroundTint="@color/status_gray" />

        <TextView
            android:id="@+id/tvServiceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Service Status: Checking..."
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Enable Service Button -->
    <Button
        android:id="@+id/btnOpenAccessibility"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="@string/btn_open_accessibility"
        android:textColor="@color/white"
        android:backgroundTint="@color/accent_primary"
        android:fontFamily="sans-serif-medium" />

    <!-- Mic Permission Button -->
    <Button
        android:id="@+id/btnRequestMicPermission"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:text="Grant Microphone Permission"
        android:textColor="@color/text_primary"
        android:backgroundTint="@color/button_bg"
        android:fontFamily="sans-serif-medium" />

    <!-- Backend Server Settings -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="BACKEND SERVER SETTINGS"
        android:textSize="11sp"
        android:letterSpacing="0.1"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary"
        android:fontFamily="sans-serif-medium" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:background="@drawable/bg_toolbar_glass"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API Endpoint (Use your Mac's Wi-Fi IP on real phone):"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etBackendUrl"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="#1B1E28"
            android:paddingHorizontal="10dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:inputType="textUri"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnTestBackend"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Test &amp; Save"
                android:textSize="12sp"
                android:backgroundTint="@color/button_bg"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvBackendStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Not tested"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Test Field Area -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="TEST PLAYGROUND"
        android:textSize="11sp"
        android:letterSpacing="0.1"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary"
        android:fontFamily="sans-serif-medium" />

    <EditText
        android:id="@+id/etTestInput"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_toolbar_glass"
        android:padding="12dp"
        android:gravity="top|start"
        android:hint="Type rough English or Hinglish here (e.g. 'kal meeting kitne baje hai bro?')..."
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:inputType="textMultiLine" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Tap above to open keyboard. Keyflow docks above Gboard:\n• Default mode: Voice-to-Text (tap to record, tap to stop &amp; transcribe)\n• Double-tap: Toggle between Voice and Text modes\n• Click &amp; hold: Vertical liquid-glass tone selector\n• Text Selection: Rewrites highlighted text in-place"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="2dp" />

</LinearLayout>
